<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <UserSecretsId>3fc388f9-f2d2-49a6-8903-e3f312921714</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!-- Ne jamais compiler les projets imbriqués dans le projet API -->
  <ItemGroup>
    <Compile Remove="FabRun.Api.Tests/**/*.cs" />
    <EmbeddedResource Remove="FabRun.Api.Tests/**/*" />
    <None Remove="FabRun.Api.Tests/**/*" />
    <None Remove="Data/**/*.json" />
    <None Remove="certs/**/*" />
    <None Remove="deploy/**/*" />
    <None Remove="docs/**/*" />
    <None Remove="strava-front/**/*" />
    <Content Remove="Data/**/*.json" />
    <Content Remove="certs/**/*" />
    <Content Remove="deploy/**/*" />
    <Content Remove="docs/**/*" />
    <Content Remove="FabRun.Api.Tests/**/*" />
    <Content Remove="strava-front/**/*" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
